# 国内镜像源加速（如需恢复官方源，删除本文件或改为 https://registry.npmjs.org/）
registry=https://registry.npmmirror.com

# better-sqlite3 等原生模块的二进制镜像（本项目已改用 node:sqlite，此项为兼容保留）
better_sqlite3_binary_host=https://registry.npmmirror.com/-/binary/better-sqlite3

# Electron 预编译二进制（约 100MB）走镜像。默认从 github.com 下载，
# 本机代理对 github release 不稳定，必须显式指定，否则 install 会卡死或 502。
electron_mirror=https://registry.npmmirror.com/-/binary/electron/

# electron-builder 在打包阶段还会下载 winCodeSign / nsis 等辅助二进制，
# 同样走镜像，否则 `electron-builder` 会在「下载依赖」这一步失败。
electron_builder_binaries_mirror=https://registry.npmmirror.com/-/binary/electron-builder-binaries/
