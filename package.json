{
  "name": "opc-agent",
  "version": "1.0.0",
  "description": "本机多 Agent 团队协作桌面应用 —— 把本机安装的各类 Agent 当作通讯录里的联系人，可单聊也可拉群分派任务",
  "author": "OPC Agent",
  "type": "module",
  "main": "dist-electron/bootstrap.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:dev": "npm run build:electron && concurrently -k \"vite\" \"electron . --dev\"",
    "electron:build": "npm run build && npm run build:electron && node scripts/build-installer.mjs",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "verify:tokens": "node scripts/verify-tokens.mjs",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:responsive": "node scripts/verify-responsive.mjs",
    "verify:render": "node scripts/render-check.mjs",
    "verify:orchestrator": "tsx scripts/verify-orchestrator.ts",
    "verify:routing": "tsx scripts/verify-agent-routing.ts",
    "verify:modelgate": "node scripts/verify-modelgate.mjs",
    "verify:groupchat": "node scripts/verify-groupchat.mjs",
    "verify:session": "tsx scripts/verify-session-persist.ts",
    "verify:scenarios": "tsx scripts/verify-scenarios.ts",
    "verify:permission": "tsx scripts/verify-permission.ts",
    "verify:scenario-ui": "node scripts/verify-scenario-ui.mjs",
    "verify:image": "tsx scripts/verify-image.ts",
    "verify:image-ui": "node scripts/verify-image-ui.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:native-theme": "node scripts/verify-native-theme.mjs",
    "verify:ui": "npm run build && npm run verify:tokens && npm run verify:theme && npm run verify:responsive && npm run verify:render && npm run verify:modelgate && npm run verify:groupchat && npm run verify:scenario-ui && npm run verify:image-ui && npm run verify:package && npm run verify:native-theme"
  },
  "dependencies": {
    "@tencent-ai/agent-sdk": "^0.3.43",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@tdesign-react/chat": "^1.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "less": "^4.3.0",
    "lucide-react": "^0.563.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "tailwindcss": "^3.4.17",
    "tdesign-icons-react": "^0.5.0",
    "tdesign-react": "^1.12.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vite": "^5.0.10"
  }
}
