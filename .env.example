# CodeBuddy Agent SDK 凭据配置
# 方式一（推荐）：直接使用 CodeBuddy CLI 登录，无需配置本文件
#   codebuddy login
#
# 方式二：在此填写以下任一凭据
# CODEBUDDY_API_KEY=your_api_key_here
# CODEBUDDY_AUTH_TOKEN=your_auth_token_here
# CODEBUDDY_INTERNET_ENVIRONMENT=external
# CODEBUDDY_BASE_URL=

# 后端服务端口（默认 3000，需与 vite.config.ts 中的 proxy target 一致）
PORT=3000

# ===== 生图（P4-4）=====
# 「生图」场景走独立 provider 直连智谱 CogView（open.bigmodel.cn）。
# 密钥从环境变量读取，两个变量名都认（写一个即可），**不要提交真实密钥**。
# 获取地址：https://open.bigmodel.cn
#
# 说明：默认模型 cogview-3-flash 免费可用，但产物**带水印**；
#       要无水印需账户有资源包并改用 cogview-4 / cogview-3-plus。
# ZHIPU_API_KEY=
# GLM_API_KEY=

# 数据目录（打包后由 Electron 指向 userData；开发态默认 ./data）
# 数据库 chat.db 与生成图缓存 images/ 都在这里
# OPC_DATA_DIR=
