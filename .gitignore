node_modules/
dist/
dist-electron/
release/
release-out/
release-p*/
# release-latest/ 是「最新一版」的二进制快照（约 775 MB），release-builds/ 是
# build-installer.mjs 在默认输出目录被安全软件咬住时的回退输出目录 ——
# 两者都是本地产物，绝不能进库（漏一个 `git add -A` 就是 775 MB 进历史）。
release-latest/
release-builds/
.trash-*/
.tmp/
*.log
.DS_Store
Thumbs.db

# 构建缓存：每次 tsc -b 都会重写，内容无意义，提交只会制造噪音
*.tsbuildinfo

# 验证脚本的截图产物：每次跑 verify:* 都会整批重写。
# 它们是「给人看的证据」，不是需要版本化的资产 —— 留在磁盘上即可。
.render-check/
# 设计预览页（preview-thinking.html）的截图产物，同理。
.preview-shots/

# ── data/ 整个目录都是本机运行时数据，一律不进版本库 ──────────────────
# 逐项说明（漏任何一条都可能把隐私推上远端）：
#   chat.db / *.db-shm / *.db-wal  sessions / messages 真实对话内容
#                                  （历史上曾被提交：29cfa11、7ec1f0f）
#   agent-credentials.json         各 Agent 的 API Key / 访问令牌（最敏感）
#   permission-rules.json          用户自定义权限规则，含本机路径
#   cdp.json                       浏览器调试端口 / CDP 地址
#   model-catalog.json             模型目录，含已授权 provider
#   memory/                        MEMORY.md / USER.md / skills，含个人偏好
#   images/                        生成的图片，可能含隐私内容
data/

# Wrangler 本地缓存（site/worker 部署统计后端时产生）
site/worker/.wrangler/
